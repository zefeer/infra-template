// Alloy log collection pipeline for Loki.
// Design notes: docs/observability.md

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
	// Label the app Services select on
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}
	// namespace/container, not pod name: bounded cardinality
	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "job"
	}
}

// Logs are read through the Kubernetes API, not from a hostPath mount
// of /var/log/pods
loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.write.default.receiver]
}

// Kubernetes Events as a log stream.
//
// Events are the record of why the kubelet did something - "Liveness probe
// failed", "Killing container", "Back-off restarting" - and they expire from
// the API after about an hour. That is routinely shorter than the time it takes
// anyone to ask why a pod restarted, so the answer is usually already gone.
// Shipping them to Loki keeps them for the log retention window instead.
//
// Note this only captures events from the moment Alloy starts; there is no
// backfill, because there is nothing left to backfill from.
loki.source.kubernetes_events "cluster" {
	// All namespaces.
	job_name = "kubernetes-events"
	// Structured, so LogQL can filter on reason/kind without regex.
	log_format = "json"
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
	}
}
